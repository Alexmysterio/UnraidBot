# ---------------------------------------------------------------------------
# UnraidBot · copia este archivo a .env y rellena los valores
# También puedes generarlo con: bash scripts/setup.sh
# ---------------------------------------------------------------------------

# Opcional: usa una imagen ya publicada en lugar de construir en local.
# UNRAIDBOT_IMAGE=ghcr.io/alexmysterio/unraidbot:latest

# 1) Token del bot de Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=

# 2) Tus IDs de usuario de Telegram (y los de quien pueda administrar).
#    Arranca el bot con ALLOWED_USER_IDS vacío, envíale /id y copia el número.
#    Varios IDs separados por comas: 11111111,22222222
ALLOWED_USER_IDS=

# Usuarios con acceso de solo lectura (no pueden arrancar/parar nada).
# VIEWER_USER_IDS=33333333

# 3) API key de Unraid (Settings → Management Access → API Keys).
#    Recomendado: rol ADMIN, o permisos de lectura/escritura sobre
#    ARRAY, DOCKER, VMS, INFO, DISK, NOTIFICATIONS y SHARE.
UNRAID_API_KEY=

# 4) URL de la API GraphQL. Por defecto, el host visto desde el contenedor.
#    Si usas SSL: https://192.168.1.10/graphql y UNRAID_VERIFY_SSL=false
UNRAID_API_URL=http://host.docker.internal/graphql

# Alternativa avanzada: socket Unix de nginx (requiere montarlo en compose y
# que el usuario del contenedor pueda leerlo). Si se define, manda sobre la URL.
# UNRAID_API_SOCKET=/var/run/nginx.sock

# Los certificados de Unraid suelen ser autofirmados.
UNRAID_VERIFY_SSL=false

# ---------------------------------------------------------------------------
# Seguridad y comportamiento
# ---------------------------------------------------------------------------

# Si true, solo se permiten lecturas (no arranca/para nada).
READ_ONLY=false

# Limitar los chats permitidos (grupos/canales). Los privados de usuarios
# autorizados siempre se permiten. Ejemplo: -1001234567890
ALLOWED_CHAT_IDS=

# Nombre del contenedor del bot: impide que el bot se pare a sí mismo.
BOT_CONTAINER_NAME=unraidbot

# ---------------------------------------------------------------------------
# Alertas automáticas
# ---------------------------------------------------------------------------
ALERTS_ENABLED=true
ALERT_INTERVAL_SECONDS=300
ALERT_REPEAT_MINUTES=360
DISK_TEMP_WARNING=50
DISK_TEMP_CRITICAL=55
CPU_TEMP_WARNING=85
MEMORY_WARNING=90
# Uso del array y de cada share (porcentaje)
ARRAY_USAGE_WARNING=85
SHARE_USAGE_WARNING=90
# Días máximos sin comprobar la paridad
PARITY_MAX_DAYS=45
# Avisa si la API de Unraid lleva dos ciclos sin responder
API_OFFLINE_ALERT=true

# ---------------------------------------------------------------------------
# Resumen diario (digest)
# ---------------------------------------------------------------------------
# Envía un resumen del servidor a los chats suscritos cada día.
DIGEST_ENABLED=true
# Hora local del envío (TIMEZONE), en formato 24 h.
DIGEST_HOUR=9
DIGEST_MINUTE=0

# ---------------------------------------------------------------------------
# Servicios extra (active / noactive)
# ---------------------------------------------------------------------------
# Todos son opcionales y se pueden activar por separado en docker-compose.yml.
# Los antiguos FEATURE_* siguen funcionando como alias, pero SERVICE_* manda.

# qBittorrent (WebAPI v2)
SERVICE_QBITTORRENT=noactive
# QBITTORRENT_URL=http://192.168.1.20:8080
# QBITTORRENT_USERNAME=admin
# QBITTORRENT_PASSWORD=
# QBITTORRENT_VERIFY_SSL=false

# MikroTik (RouterOS 7 REST)
SERVICE_MIKROTIK=noactive
# MIKROTIK_URL=https://192.168.1.1
# MIKROTIK_USERNAME=admin
# MIKROTIK_PASSWORD=
# MIKROTIK_VERIFY_SSL=false

# Wake-on-LAN multi-equipo
SERVICE_WOL=noactive
# Formato: Nombre=MAC[@broadcast], separados por comas o saltos de línea.
# WOL_DEVICES=NAS=AA:BB:CC:DD:EE:FF,PC=11:22:33:44:55:66@192.168.1.255
# WOL_BROADCAST=255.255.255.255
# Compatibilidad: si solo defines WOL_MAC se crea el equipo «Equipo».
# WOL_MAC=AA:BB:CC:DD:EE:FF

# Proxy de salida para Telegram (SOCKS5/HTTP). Útil si Telegram está bloqueado.
SERVICE_TELEGRAM_PROXY=noactive
# TELEGRAM_PROXY_URL=socks5://192.168.1.30:1080

# Limitador global de Telegram (reintentos ante 429) y límite por usuario.
TELEGRAM_RATE_LIMIT=active
TELEGRAM_RATE_LIMIT_MAX_RETRIES=2
USER_RATE_LIMIT_ACTIONS=30
USER_RATE_LIMIT_WINDOW=60

# ---------------------------------------------------------------------------
# Varios
# ---------------------------------------------------------------------------
TIMEZONE=Europe/Madrid
LOG_LEVEL=INFO
DATA_DIR=/data

# UID/GID de Unraid para ./data (99:100 = nobody:users)
PUID=99
PGID=100
TZ=Europe/Madrid
