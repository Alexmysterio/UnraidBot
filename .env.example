# ---------------------------------------------------------------------------
# UnraidBot · copia este archivo a .env y rellena los valores
# También puedes generarlo con: bash scripts/setup.sh
# ---------------------------------------------------------------------------

# Opcional: usa una imagen ya publicada en lugar de construir en local.
# UNRAIDBOT_IMAGE=ghcr.io/TU_USUARIO/unraidbot:latest

# 1) Token del bot de Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=

# 2) Tus IDs de usuario de Telegram (y los de quien pueda administrar).
#    Arranca el bot con ALLOWED_USER_IDS vacío, envíale /id y copia el número.
#    Varios IDs separados por comas: 11111111,22222222
ALLOWED_USER_IDS=

# Usuarios con acceso de solo lectura (no pueden arrancar/parar nada).
# VIEWER_USER_IDS=33333333

# 3) API key de Unraid (Settings → Management Access → API Keys).
#    Recomendado: rol ADMIN, o permisos de lectura/escritura sobre
#    ARRAY, DOCKER, VMS, INFO, DISK, NOTIFICATIONS y SHARE.
UNRAID_API_KEY=

# 4) URL de la API GraphQL. Por defecto, el host visto desde el contenedor.
#    Si usas SSL: https://192.168.1.10/graphql y UNRAID_VERIFY_SSL=false
UNRAID_API_URL=http://host.docker.internal/graphql

# Alternativa avanzada: socket Unix de nginx (requiere montarlo en compose y
# que el usuario del contenedor pueda leerlo). Si se define, manda sobre la URL.
# UNRAID_API_SOCKET=/var/run/nginx.sock

# Los certificados de Unraid suelen ser autofirmados.
UNRAID_VERIFY_SSL=false

# ---------------------------------------------------------------------------
# Seguridad y comportamiento
# ---------------------------------------------------------------------------

# Si true, solo se permiten lecturas (no arranca/para nada).
READ_ONLY=false

# Limitar los chats permitidos (grupos/canales). Los privados de usuarios
# autorizados siempre se permiten. Ejemplo: -1001234567890
ALLOWED_CHAT_IDS=

# Nombre del contenedor del bot: impide que el bot se pare a sí mismo.
BOT_CONTAINER_NAME=unraidbot

# ---------------------------------------------------------------------------
# Alertas automáticas
# ---------------------------------------------------------------------------
ALERTS_ENABLED=true
ALERT_INTERVAL_SECONDS=300
ALERT_REPEAT_MINUTES=360
DISK_TEMP_WARNING=50
DISK_TEMP_CRITICAL=55
CPU_TEMP_WARNING=85
MEMORY_WARNING=90

# ---------------------------------------------------------------------------
# Varios
# ---------------------------------------------------------------------------
TIMEZONE=Europe/Madrid
LOG_LEVEL=INFO
DATA_DIR=/data

# UID/GID de Unraid para ./data (99:100 = nobody:users)
PUID=99
PGID=100
TZ=Europe/Madrid
